# ─────────────────────────────────────────────────────────────
# Interview Intelligence — Environment Variables
# Copy to .env.local for local dev. On Vercel: Project > Settings > Environment Variables
# ─────────────────────────────────────────────────────────────

# Google Gemini API Key (Recommended — 1M token free tier, no transcript length issues)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional — fast but limited to 12K tokens/min on free tier)
# Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Optional — free models with independent rate limits)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Mistral AI API Key (Optional — free tier available)
# Get key at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here
